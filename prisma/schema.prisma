// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  TUTOR
  PARENT
  STUDENT
  ADMIN
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// TUTOR_APPLY  = 教员主动申请接单（关联 requirement）
// PARENT_BOOK  = 家长主动预约教员（不关联 requirement）
enum ApplicationType {
  TUTOR_APPLY
  PARENT_BOOK
}

enum GradeLevel {
  PRIMARY
  MIDDLE
  HIGH
  UNDERGRADUATE
  GRADUATE
  OTHER
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  emailVerified DateTime?
  passwordHash  String?
  name          String
  avatarUrl     String?
  image         String?
  role          Role          @default(STUDENT)
  phone         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  accounts     Account[]
  sessions     Session[]
  tutorProfile TutorProfile?
  requirements Requirement[]
  sentApplications     Application[] @relation("ApplicationSender")
  receivedApplications Application[] @relation("ApplicationReceiver")
  reviews      Review[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model TutorProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  university  String
  major       String
  grade       String
  hourlyRate  Float
  rating      Float    @default(0)
  reviewCount Int      @default(0)
  bio         String
  available   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects TutorSubject[]
  tags     TutorTag[]
  regions  TutorRegion[]
  applications Application[]
  reviews  Review[]
}

model TutorSubject {
  id             String       @id @default(cuid())
  tutorProfileId String
  subjectName    String

  tutorProfile TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  @@unique([tutorProfileId, subjectName])
  @@index([subjectName])
}

model TutorTag {
  id             String       @id @default(cuid())
  tutorProfileId String
  tag            String

  tutorProfile TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  @@unique([tutorProfileId, tag])
}

model TutorRegion {
  id             String       @id @default(cuid())
  tutorProfileId String
  regionName     String

  tutorProfile TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  @@unique([tutorProfileId, regionName])
  @@index([regionName])
}

model Requirement {
  id           String     @id @default(cuid())
  userId       String
  subjectName  String
  gradeLevel   GradeLevel
  budgetMin    Float?
  budgetMax    Float?
  scheduleNote String?
  description  String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  applications Application[]
  regions      RequirementRegion[]

  @@index([subjectName])
  @@index([gradeLevel])
}

model RequirementRegion {
  id            String      @id @default(cuid())
  requirementId String
  regionName    String

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([requirementId, regionName])
  @@index([regionName])
}

// ── Application (撮合记录) ──────────────────────────────────────────────────
// TUTOR_APPLY: tutor (senderUserId) applies to a requirement (requirementId)
//   receiverUserId = requirement.userId (the parent)
// PARENT_BOOK:  parent (senderUserId) books a tutor (tutorProfileId)
//   receiverUserId = tutorProfile.userId (the tutor)
model Application {
  id             String            @id @default(cuid())
  type           ApplicationType
  status         ApplicationStatus @default(PENDING)
  message        String?

  // Who initiated this application
  senderUserId   String
  // Who receives / reviews this application
  receiverUserId String

  // Always set — which tutor profile this is about
  tutorProfileId String
  // Set only for TUTOR_APPLY
  requirementId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sender      User         @relation("ApplicationSender",   fields: [senderUserId],   references: [id], onDelete: Cascade)
  receiver    User         @relation("ApplicationReceiver", fields: [receiverUserId], references: [id], onDelete: Cascade)
  tutorProfile TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  requirement  Requirement? @relation(fields: [requirementId],  references: [id], onDelete: SetNull)
  review       Review?

  @@index([senderUserId])
  @@index([receiverUserId])
  @@index([tutorProfileId])
  @@index([requirementId])
}

// ── PasswordResetToken ─────────────────────────────────────────────────────
model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

// ── Review (评价) ──────────────────────────────────────────────────────────
model Review {
  id             String   @id @default(cuid())
  rating         Int      // 1-5
  content        String
  createdAt      DateTime @default(now())

  authorId       String
  tutorProfileId String
  applicationId  String   @unique

  author       User         @relation(fields: [authorId],       references: [id], onDelete: Cascade)
  tutorProfile TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  application  Application  @relation(fields: [applicationId],  references: [id], onDelete: Cascade)

  @@index([tutorProfileId])
  @@index([authorId])
}
